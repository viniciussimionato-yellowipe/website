# Copie para .env.local e preencha. Nunca faça commit de .env.local.
# Variáveis NEXT_PUBLIC_* ficam visíveis no browser: nunca coloque segredos nelas.

# URL público do site, sem barra final (produção: https://www.yellowipe.io)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ambiente: development | preview | staging | production
# Fora de production o site responde com noindex.
NEXT_PUBLIC_APP_ENV=development

# Conteúdo: 1 = textos pendentes [ ] e casos sem autorização bloqueiam o build.
# Ligar só no deploy de produção.
CONTENT_STRICT=0

# Google Tag Manager (só carrega depois do consentimento)
NEXT_PUBLIC_GTM_ID=

# Cloudflare Turnstile (anti-spam do formulário)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# CRM (HubSpot por omissão; ver docs/adr/0004-formulario-e-crm.md)
CRM_PROVIDER=log            # log | hubspot
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID_CLIENT=
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_SUBSCRIPTION_ID=     # opcional: tipo de subscrição para o consentimento de marketing

# ATS (candidaturas)
ATS_PROVIDER=log            # log | webhook
ATS_WEBHOOK_URL=
ATS_WEBHOOK_SECRET=

# Limite de envios do formulário por IP a cada 10 minutos (melhor esforço)
LEAD_RATE_LIMIT=5

# Calendário para leads com 50+ pontos (por mercado)
NEXT_PUBLIC_MEETING_URL_PT=
NEXT_PUBLIC_MEETING_URL_BR=
NEXT_PUBLIC_MEETING_URL_US=
